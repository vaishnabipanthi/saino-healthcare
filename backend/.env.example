```env
# PostgreSQL database connection
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/sainodb

# Backend server port
PORT=4000

# Shared signing secret for provider, admin, and patient sessions (32+ characters)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Frontend origins allowed to access the backend
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:4000,http://127.0.0.1:4000

# Razorpay merchant credentials (add real values only to backend/.env)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Patient sign-in and appointment OTP delivery
# Resend: API key + a verified sender/domain (or the onboarding sender while testing)
RESEND_API_KEY=re_your_resend_api_key
OTP_FROM_EMAIL=SAINO Health <otp@your-verified-domain.com>

# MSG91: use an approved Indian DLT SMS template with VAR1 = OTP and VAR2 = expiry text
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_OTP_TEMPLATE_ID=your_msg91_template_id
```
